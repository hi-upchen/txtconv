# Vercel Blob Storage - stores each user's custom dictionary (dictionaries/<user-id>.csv)
# Nothing else may be written to Blob; see __tests__/guards/blob-write-guard.test.ts
# Get this token from: https://vercel.com/dashboard/stores
#
# SECURITY NOTICE - Access Control Limitations:
# ==============================================
# As of January 2025, Vercel Blob does NOT support private access:
#
# 1. Only 'public' access is available - all blobs are publicly accessible via URL
# 2. Private access is planned but no ETA announced (GitHub issue #816)
# 3. Current security relies on cryptographically random URLs (addRandomSuffix: true)
#
# What this means:
# - Anyone with the blob URL can access the file
# - URLs are practically impossible to guess without knowledge
# - This is "security through obscurity", not true access control
#
# Recommendations:
# - Do NOT store sensitive/private data in Vercel Blob at this time
# - Use alternative storage (S3, etc.) if true private access is required
# - Consider edge middleware authorization for access control
#
# Local development: Files stored in .vercel/output/blob/
# Production: Files uploaded to Vercel Blob (publicly accessible)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx
# Production blob store token (for download-blobs script)
BLOB_READ_WRITE_TOKEN_PROD=vercel_blob_rw_xxxxxxxxxxxxx

# Development Settings
# ====================
# Conversion progress delay (milliseconds) - adds artificial delay between progress updates
# Set to 50-100ms during development to see progress bars clearly
# Set to 0 (or omit) for production to run at full speed
CONVERSION_PROGRESS_DELAY_MS=50

# Supabase - Authentication & Database
# =====================================
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gumroad - legacy webhook only
# ==============================
# Purchases go through ECPay. The Gumroad webhook route reads these two,
# so refunds and disputes from past Gumroad buyers keep working.
GUMROAD_SELLER_ID=your-seller-id
GUMROAD_LIFETIME_PRODUCT_ID=your-product-id

# Gumroad product URL. Not used for purchases. Kept for reference only.
NEXT_PUBLIC_GUMROAD_URL=https://your-username.gumroad.com/l/product-id

# ECPay (綠界) - Payment
# ======================
# Leave ECPAY_ENV unset, or set anything except "production", to use
# ECPay's public sandbox merchant. Set all four to go live.
# The production deployment refuses checkout unless ECPAY_ENV=production.
ECPAY_ENV=sandbox
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# Sandbox grant switch. Leave unset everywhere except a local ECPay sandbox run.
# The sandbox merchant keys are public, and preview and local runs share the
# production database. Anyone could forge a paid callback if this were enabled.
# Set to "true" only while testing the sandbox flow on your own machine.
# ECPAY_SANDBOX_GRANT=true

# Health check key
# ================
# Protects /api/health, the page that UptimeRobot polls every 5 minutes.
# Set it in Vercel Production only. Leave it unset everywhere else.
# When it is unset, every request to /api/health gets 401.
HEALTH_CHECK_KEY=

# App URL - for auth redirects
# =============================
NEXT_PUBLIC_APP_URL=http://localhost:3000
